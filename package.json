{
  "name": "aria",
  "private": true,
  "version": "1.0.0",
  "description": "Aria \u2014 a content-aware music recommender built on lyric NLP, part-level lineups, teams, and a least-recently-used lineup engine.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node server/index.js\" \"vite --host 0.0.0.0 --port 5173 --strictPort\"",
    "client": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server/index.js",
    "test:supabase": "node scripts/test-supabase.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:lyrics": "node scripts/test-lyrics-and-sharing.mjs",
    "test:playstore": "node scripts/test-playstore.mjs",
    "test:admin": "node scripts/test-admin.mjs",
    "test:classifier": "node scripts/test-classifier.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.119.0",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "pg": "^8.11.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
